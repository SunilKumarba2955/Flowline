{
  "name": "@flowline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/server.js --sourcemap --packages=external",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run test/dashboard-service.test.ts test/job-service.test.ts",
    "test:integration": "vitest run test/api.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.0",
    "graphql": "^16.11.0",
    "mercurius": "^16.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "esbuild": "0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
