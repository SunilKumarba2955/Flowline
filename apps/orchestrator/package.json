{
  "name": "@flowline/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/server.js --sourcemap --packages=external",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/orchestrator.test.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "engines": { "node": ">=20.19" }
}
