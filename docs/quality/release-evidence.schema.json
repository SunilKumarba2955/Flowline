{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowline.local/schemas/release-evidence.schema.json",
  "title": "Flowline independent QA release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "prNumber",
    "headSha",
    "riskTier",
    "testedAt",
    "tester",
    "environment",
    "developerEvidence",
    "manualCases",
    "defects",
    "nonFunctional",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "prNumber": { "type": "integer", "minimum": 1 },
    "headSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "riskTier": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "testedAt": { "type": "string", "format": "date-time" },
    "tester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubLogin", "role", "independenceAttested"],
      "properties": {
        "githubLogin": { "type": "string", "minLength": 1, "maxLength": 39 },
        "role": { "const": "INDEPENDENT_QA" },
        "independenceAttested": { "const": true }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildSha", "dataClass", "platform", "browsers", "apiMode"],
      "properties": {
        "buildSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "dataClass": { "const": "SYNTHETIC" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 200 },
        "browsers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "apiMode": { "enum": ["MOCK", "LOCAL_STACK", "PREVIEW"] }
      }
    },
    "developerEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "evidenceRef"],
        "properties": {
          "gate": { "type": "string", "minLength": 1, "maxLength": 100 },
          "status": { "enum": ["PASS", "FAIL"] },
          "evidenceRef": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "manualCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidenceRefs", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^M-[0-9]{2}$" },
          "result": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"] },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "notes": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "summary", "owner"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "severity": { "enum": ["SEV1", "SEV2", "SEV3", "SEV4"] },
          "status": { "enum": ["OPEN", "FIXED", "ACCEPTED_EXCEPTION"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
          "exceptionRef": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "nonFunctional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibility", "securityPrivacy", "performance", "resilience"],
      "properties": {
        "accessibility": { "$ref": "#/$defs/gateResult" },
        "securityPrivacy": { "$ref": "#/$defs/gateResult" },
        "performance": { "$ref": "#/$defs/gateResult" },
        "resilience": { "$ref": "#/$defs/gateResult" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "rationale", "exceptions"],
      "properties": {
        "verdict": { "enum": ["ACCEPT", "REJECT"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "exceptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  },
  "$defs": {
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceRef"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"] },
        "evidenceRef": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
